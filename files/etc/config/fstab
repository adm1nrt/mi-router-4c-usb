config global
	option anon_swap '0'
	option anon_mount '0'
	option auto_swap '1'
	option auto_mount '1'
	option delay_root '5'
	option check_fs '0'

config mount 'extroot'
	option target '/overlay'
	option label 'ROOTFS'
	option fstype 'ext4'
	option options 'rw,noatime'
	option enabled '0'
	option enabled_fsck '0'
